{
  "name": "@game-project/resolver",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic build-time resolver: data JSONs -> graph.json, ink/ tree, day.json. No LLM calls.",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "bin": {
    "resolver": "./src/cli.ts"
  },
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "node src/cli.ts build",
    "resolve-day": "node src/cli.ts resolve-day",
    "content-index": "node scripts/build-content-index.mjs",
    "content-index:check": "node scripts/build-content-index.mjs --check"
  },
  "dependencies": {
    "inkjs": "^2.3.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
